# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="AI Project Manager"
APP_VERSION="1.0.0"
DEBUG=false
# Public HTTPS URL where your app is reachable (used to register Telegram webhook)
BASE_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_pm
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_pm

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.2

# ── Notion ────────────────────────────────────────────────────────────────────
# Create an integration at https://www.notion.so/my-integrations
NOTION_TOKEN=secret_...
# The ID of your Notion database (from the database URL)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GitHub ────────────────────────────────────────────────────────────────────
# Generate at https://github.com/settings/tokens (needs repo scope)
GITHUB_TOKEN=github_pat_...
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name

# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAF...
# Random secret used to verify incoming webhook requests
TELEGRAM_WEBHOOK_SECRET=change_me_to_a_random_string
